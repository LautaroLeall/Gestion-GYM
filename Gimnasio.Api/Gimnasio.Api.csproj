<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Target .NET 8.0 as suggested in the course guide. -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- Enable nullable reference types for safer code. -->
    <Nullable>enable</Nullable>
    <!-- Allow implicit usings to reduce ceremony in C# files. -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity Framework Core packages for SQLite support. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <!-- AutoMapper helps map between domain entities and DTOs. -->
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />
    <!-- Swagger generation for API documentation (optional). -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

</Project>